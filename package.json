{
  "name": "zirtola",
  "productName": "Zirtola",
  "version": "0.2.0",
  "description": "Zirtola: a fast, private, lightweight Chromium-based browser with Chrome extension support and a built-in MCP server.",
  "main": "dist/main/main.js",
  "author": "trendlinepros-afk",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trendlinepros-afk/web-browser.git"
  },
  "homepage": "https://github.com/trendlinepros-afk/web-browser#readme",
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && npm run filters && electron-builder",
    "release": "npm run build && npm run filters && electron-builder --publish always",
    "filters": "node scripts/build-filters.js",
    "bench": "npm run build && electron scripts/bench",
    "security": "npm run build && electron scripts/security-check"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-electron": "^2.20.1",
    "@ghostery/adblocker-electron-preload": "^2.20.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9",
    "tldts-experimental": "^7.4.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "desktopName": "zirtola.desktop",
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
